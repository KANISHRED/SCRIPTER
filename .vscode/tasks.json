{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Auto Git Push",
            "type": "shell",
            "command": "cmd",
            "args": [
                "/c",
                "git add . && git commit -m \"Auto-update: %date% %time%\" && git push origin main"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
